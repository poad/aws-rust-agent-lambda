{
  "name": "aws-rust-agent-lambda",
  "version": "0.1.0",
  "bin": {
    "aws-rust-rag-lambda": "bin/aws-rust-agent-lambda.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && cd lambda && cargo build",
    "clean": "tsc --build --clean && cd lambda && cargo clean",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "lint": "oxlint .",
    "lint-fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postupdate": "cd lambda && cargo update"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1147.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-awscdk": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "cargo-lambda-cdk": "^0.0.36",
    "constructs": "^10.8.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  }
}
