{
  "name": "aws-rust-agent-lambda",
  "version": "0.1.0",
  "bin": {
    "aws-rust-rag-lambda": "bin/aws-rust-agent-lambda.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && cd lambda && cargo build",
    "clean": "tsc --build --clean && cd lambda && cargo clean",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "postupdate": "cd lambda && cargo update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "aws-cdk": "^2.1135.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-awscdk": "^4.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.263.0",
    "cargo-lambda-cdk": "^0.0.36",
    "constructs": "^10.8.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  }
}
